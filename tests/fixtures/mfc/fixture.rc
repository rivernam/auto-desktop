#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_FIXTURE_MAIN DIALOGEX 0, 0, 380, 280
STYLE DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "MFC fixture"
FONT 9, "Segoe UI"
BEGIN
END

IDD_FIXTURE_MODAL DIALOGEX 0, 0, 205, 76
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Fixture modal"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Confirm the fixture action.", -1, 12, 12, 181, 12
    DEFPUSHBUTTON "Accept modal", IDOK, 35, 44, 64, 16
    PUSHBUTTON "Cancel modal", IDCANCEL, 106, 44, 64, 16
END

IDD_FIXTURE_GENERAL DIALOGEX 0, 0, 205, 82
STYLE DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "General"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Document label", -1, 12, 12, 181, 12
    EDITTEXT IDC_FIXTURE_GENERAL_EDIT, 12, 28, 181, 16, ES_AUTOHSCROLL
END

IDD_FIXTURE_ADVANCED DIALOGEX 0, 0, 205, 82
STYLE DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Advanced"
FONT 9, "Segoe UI"
BEGIN
    AUTOCHECKBOX "Enable fixture option", IDC_FIXTURE_ADVANCED_CHECK, 12, 12, 181, 16
END
